APP_NAME=VYRA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production values are supplied by the hosting environment, never committed.
# Set APP_ENV=production, APP_DEBUG=false, APP_URL to the public HTTPS URL,
# and APP_KEY to a securely generated Laravel application key.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=creator_os
DB_USERNAME=creator_os_app
DB_PASSWORD=

# Production PostgreSQL providers may expose DB_NAME. Laravel requires
# DB_DATABASE, so map the provider's database name to DB_DATABASE in its
# environment settings. Keep DB_HOST, DB_PORT, DB_USERNAME, and DB_PASSWORD
# provider-managed; do not copy production credentials into this file.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true for every HTTPS deployment. The config also defaults this to true in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
INERTIA_SSR_ENABLED=false
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Staging uses Gmail SMTP. Set credentials only as Wasmer secrets/environment
# variables. MAIL_PASSWORD must be a Google App Password, never the normal
# Gmail account password, and must not be committed.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=VYRA

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
